{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "apps/web/src/main.tsx",
    "tests/*.test.ts",
    "tests/browser/*.spec.ts",
    "tests/helpers/*.ts",
    "tests/helpers/*.cjs",
    "playwright.config.ts",
    "apps/desktop/src/main.cjs",
    "apps/desktop/src/preload.cjs",
    "apps/desktop/scripts/*.mjs",
    "apps/desktop/tests/*.test.cjs",
    "vite.config.ts",
    "apps/web/vite.config.ts",
    "eslint.config.js"
  ],
  "project": [
    "apps/web/src/**/*.{ts,tsx,css}",
    "packages/ui/src/**/*.{ts,tsx}",
    "apps/desktop/{src,scripts,tests}/**/*.{cjs,mjs}",
    "tests/**/*.{ts,cjs}",
    "playwright.config.ts",
    "vite.config.ts",
    "apps/web/vite.config.ts",
    "eslint.config.js"
  ],
  "paths": {
    "@/*": ["apps/web/src/*"],
    "@homun/ui/*": ["packages/ui/src/*"]
  },
  "ignore": [
    // Citati dai documenti di piano storici in docs/superpowers/plans/2026-09-15-*.md:
    // rimandati a una decisione dedicata.
    "apps/web/src/components/builder/FirstWorkJourney.tsx",
    "apps/web/src/components/builder/FirstWorkSpace.tsx",
    "apps/web/src/components/builder/WorkProposal.tsx",
    // Dipendenza diretta dei due file sopra (Choice, JourneyField): eliminabile
    // solo insieme a loro.
    "apps/web/src/components/builder/FirstWorkFields.tsx",
    // Importato da FirstWorkFields/FirstWorkJourney (sopra): eliminabile solo
    // insieme a loro.
    "packages/ui/src/components/label.tsx"
  ]
}
