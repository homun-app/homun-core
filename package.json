{
  "name": "sandbot",
  "version": "0.1.0",
  "description": "Clone locale di Grok Bot con modelli personalizzati",
  "main": "./out/main/index.js",
  "scripts": {
    "prepare-wasm": "node scripts/prepare-wasm.mjs",
    "pretest": "node scripts/prepare-wasm.mjs",
    "predev": "node scripts/prepare-wasm.mjs",
    "predist": "node scripts/prepare-wasm.mjs",
    "test": "vitest run",
    "i18n:extract": "lingui extract --clean && lingui compile --namespace es",
    "eval": "node scripts/run-eval.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac",
    "typecheck": "tsc --noEmit",
    "i18n:compile": "lingui compile --namespace es"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@lingui/core": "6.6.0",
    "@lingui/react": "6.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ipaddr.js": "2.2.0",
    "lucide-react": "1.64.0",
    "mermaid": "12.2.0",
    "node-cron": "^4.6.0",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.7.0",
    "tree-sitter-bash": "^0.25.1",
    "tw-animate-css": "1.4.0",
    "vega": "6.4.0",
    "vega-lite": "6.5.0",
    "web-tree-sitter": "^0.27.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "6.6.0",
    "@lingui/cli": "6.6.0",
    "@lingui/conf": "6.6.0",
    "@lingui/format-po": "6.6.0",
    "@lingui/vite-plugin": "6.6.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.fabio.sandbot",
    "productName": "Homun",
    "asar": "true",
    "files": "out/**/*",
    "asarUnpack": [
      "out/main/daemon.js"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor"
      },
      {
        "from": "resources/box",
        "to": "box"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Homun usa il microfono solo se abiliti l'input vocale",
        "NSCameraUsageDescription": "Homun usa la camera solo se richiesta da una funzione"
      }
    }
  }
}
