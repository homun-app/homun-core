{
  "name": "sandbot",
  "version": "0.1.0",
  "description": "Clone locale di Grok Bot con modelli personalizzati",
  "main": "./out/main/index.js",
  "scripts": {
    "prepare-wasm": "node scripts/prepare-wasm.mjs",
    "pretest": "node scripts/prepare-wasm.mjs",
    "predev": "node scripts/prepare-wasm.mjs",
    "predist": "node scripts/prepare-wasm.mjs",
    "test": "vitest run",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "node-cron": "^4.6.0",
    "openai": "^7.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tree-sitter-bash": "^0.25.1",
    "web-tree-sitter": "^0.27.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.fabio.sandbot",
    "productName": "SandBot",
    "asar": "true",
    "files": "out/**/*",
    "asarUnpack": ["out/main/daemon.js"],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "SandBot usa il microfono solo se abiliti l'input vocale",
        "NSCameraUsageDescription": "SandBot usa la camera solo se richiesta da una funzione"
      }
    }
  }
}
